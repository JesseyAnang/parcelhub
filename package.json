{
  "name": "parcelhub",
  "private": true,
  "description": "Cloud-based parcel services platform: drop-off and collection journeys, carrier integrations, transactions, tracking and reclaim.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "infra"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w @parcelhub/web",
    "synth": "npm run synth -w @parcelhub/infra"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.4"
  }
}
