{
  "name": "@parcelhub/infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK app (TypeScript) for ParcelHub. Nothing here deploys unless you run deploy yourself.",
  "scripts": {
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy --all",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "aws-cdk-lib": "^2.200.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "aws-cdk": "^2.1019.0",
    "esbuild": "^0.25.5",
    "tsx": "^4.20.3"
  }
}
